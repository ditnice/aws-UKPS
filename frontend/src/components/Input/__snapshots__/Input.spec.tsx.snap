// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`Input > applies a max-width for a fixed width 1`] = `
<DocumentFragment>
  <div
    class="input"
    data-component="input"
  >
    <label
      class="input__label"
      for="age"
    >
      Age
    </label>
    <input
      class="input__input"
      id="age"
      name="age"
      style="max-width: 11.5em;"
      type="text"
    />
  </div>
</DocumentFragment>
`;

