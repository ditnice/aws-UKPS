exports[`Input > associates hint text with the input 1`] = `
<DocumentFragment>
  <div
    class="input"
    data-component="input"
  >
    <label
      class="input__label"
      for="age"
    >
      Age
    </label>
    <p
      class="input__hint"
      id="age-hint"
    >
      Please enter in years
    </p>
    <input
      aria-describedby="age-hint"
      class="input__input"
      id="age"
      name="age"
      type="text"
    />
  </div>
</DocumentFragment>
`;

