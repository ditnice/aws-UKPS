// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`SummaryList > adds hidden context to a row action child 1`] = `
<DocumentFragment>
  <dl
    class="_summary-list_1509a2"
    data-component="summary-list"
  >
    <div
      class="_summary-list__row_1509a2"
    >
      <dt
        class="_summary-list__key_1509a2"
      >
        Name
      </dt>
      <dd
        class="_summary-list__value_1509a2"
      >
        Sarah Philips
      </dd>
      <dd
        class="_summary-list__actions_1509a2"
      >
        <a
          aria-label="Change name"
          href="/change-name"
        >
          Change
          <span
            class="visually-hidden"
          >
            name
          </span>
        </a>
      </dd>
    </div>
  </dl>
</DocumentFragment>
`;

