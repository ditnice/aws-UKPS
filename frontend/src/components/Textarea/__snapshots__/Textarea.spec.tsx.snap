exports[`Textarea > applies a max-width for a fixed width 1`] = `
<DocumentFragment>
  <div
    class="textarea"
    data-component="textarea"
  >
    <label
      class="textarea__label"
      for="description"
    >
      Description
    </label>
    <textarea
      class="textarea__textarea"
      id="description"
      name="description"
      style="max-width: 11.5em;"
    />
  </div>
</DocumentFragment>
`;

