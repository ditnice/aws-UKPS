exports[`Textarea > forwards other textarea props 1`] = `
<DocumentFragment>
  <div
    class="textarea"
    data-component="textarea"
  >
    <label
      class="textarea__label"
      for="description"
    >
      Description
    </label>
    <p
      class="textarea__hint"
    >
      Include all relevant details
    </p>
    <textarea
      class="textarea__textarea"
      id="description"
      name="description"
      placeholder="Enter a description"
      rows="8"
    />
  </div>
</DocumentFragment>
`;

