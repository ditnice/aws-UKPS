DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/ukps-payload
# AWS/ECS can use DATABASE_HOST, DATABASE_NAME, DATABASE_PORT, DATABASE_USERNAME, and DATABASE_PASSWORD instead of DATABASE_URL.
# DATABASE_HOST=localhost
# DATABASE_NAME=ukps-payload
# DATABASE_PORT=5432
# DATABASE_USERNAME=postgres
# DATABASE_PASSWORD=postgres
PAYLOAD_SECRET=YOUR_SECRET_HERE
# Browser API calls use /backend-api; this is the server-side proxy target.
BACKEND_API_BASE_URL=https://localhost:7180
COGNITO_ISSUER=https://cognito-idp.eu-west-2.amazonaws.com/YOUR_USER_POOL_ID
COGNITO_CLIENT_ID=YOUR_COGNITO_APP_CLIENT_ID
NEXT_PUBLIC_QA_SUPPORT_EMAIL=QA@UKPS.com
# Playwright. `just e2e` (Docker Compose) sets these itself; set them here only to run
# Playwright from your machine against `just stack-up`.
# PLAYWRIGHT_BASE_URL=http://localhost:3000
# PLAYWRIGHT_SKIP_WEB_SERVER=1
# E2E_AUTH_MODE=dev
# E2E_ORGANISATION_ID=1
