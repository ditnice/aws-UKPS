DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/ukps-payload
# AWS/ECS can use DATABASE_HOST, DATABASE_NAME, DATABASE_PORT, DATABASE_USERNAME, and DATABASE_PASSWORD instead of DATABASE_URL.
# DATABASE_HOST=localhost
# DATABASE_NAME=ukps-payload
# DATABASE_PORT=5432
# DATABASE_USERNAME=postgres
# DATABASE_PASSWORD=postgres
PAYLOAD_SECRET=YOUR_SECRET_OF_AT_LEAST_32_CHARACTERS
# Browser API calls use /backend-api; this is the server-side proxy target.
BACKEND_API_BASE_URL=https://localhost:7180
BACKEND_API_TIMEOUT_MS=15000
# Optional override used to validate the Origin header on unsafe proxy requests.
# FRONTEND_PUBLIC_ORIGIN=https://localhost:3000
# Use DEV to bypass Cognito authentication for local development.
AUTHENTICATION_MODE=DEV
# Cognito values are required when AUTHENTICATION_MODE is not DEV.
COGNITO_ISSUER=https://cognito-idp.eu-west-2.amazonaws.com/eu-west-2_YOURUSERPOOLID
COGNITO_CLIENT_ID=YOURCOGNITOAPPCLIENTID
