{
  "name": "ukps-frontend",
  "private": true,
  "version": "1.0.0",
  "description": "UKPS Frontend solution using Next.js with Payload 3",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "cross-env NODE_OPTIONS=\"--no-deprecation --max-old-space-size=8000\" next build --webpack",
    "dev": "cross-env NODE_OPTIONS=--no-deprecation next dev --webpack --experimental-https --experimental-https-key ./certificates/localhost-key.pem --experimental-https-cert ./certificates/localhost.pem --experimental-https-ca ./certificates/aspnetcore-dev-cert.pem",
    "devsafe": "rm -rf .next && cross-env NODE_OPTIONS=--no-deprecation next dev --webpack --experimental-https --experimental-https-key ./certificates/localhost-key.pem --experimental-https-cert ./certificates/localhost.pem --experimental-https-ca ./certificates/aspnetcore-dev-cert.pem",
    "generate:importmap": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap",
    "generate:api": "openapi-ts",
    "generate:types": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types",
    "fallow": "fallow",
    "lint": "cross-env NODE_OPTIONS=--no-deprecation eslint .",
    "lint:style": "stylelint \"**/*.{css,scss}\"",
    "lint:check": "pnpm lint && pnpm lint:style && prettier --check .",
    "lint:fix": "cross-env NODE_OPTIONS=--no-deprecation eslint . --fix && stylelint \"**/*.{css,scss}\" --fix && prettier --write .",
    "format:check": "prettier --check .",
    "format:fix": "prettier --write .",
    "payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
    "start": "cross-env NODE_OPTIONS=--no-deprecation next start",
    "test": "pnpm run test:unit && pnpm run test:int && pnpm run test:e2e",
    "test:e2e": "cross-env NODE_OPTIONS=\"--no-deprecation --import=tsx/esm\" playwright test --config=playwright.config.ts",
    "test:e2e:chrome": "cross-env NODE_OPTIONS=\"--no-deprecation --import=tsx/esm\" playwright test --config=playwright.config.ts --project=chromium",
    "test:e2e:dev": "cross-env PLAYWRIGHT_BASE_URL=https://dev.ukps.nice.org.uk pnpm run test:e2e",
    "test:e2e:dev:ui": "cross-env PLAYWRIGHT_BASE_URL=https://dev.ukps.nice.org.uk pnpm run test:e2e --ui",
    "test:e2e:ui": "cross-env NODE_OPTIONS=\"--no-deprecation --import=tsx/esm\" playwright test --config=playwright.config.ts --ui",
    "test:int": "cross-env NODE_OPTIONS=--no-deprecation vitest run tests/int --config ./vitest.config.mts",
    "test:unit": "cross-env NODE_OPTIONS=--no-deprecation vitest run src --config ./vitest.config.mts",
    "test:unit:refresh": "cross-env NODE_OPTIONS=--no-deprecation vitest run src --config ./vitest.config.mts -u"
  },
  "dependencies": {
    "@nice-digital/design-system": "5.6.1",
    "@nice-digital/icons": "6.1.7",
    "@nice-digital/nds-a-z-list": "4.1.0",
    "@nice-digital/nds-accordion": "0.4.0",
    "@nice-digital/nds-action-banner": "4.4.0",
    "@nice-digital/nds-alert": "4.1.0",
    "@nice-digital/nds-alphabet": "3.1.0",
    "@nice-digital/nds-breadcrumbs": "4.1.0",
    "@nice-digital/nds-button": "4.1.0",
    "@nice-digital/nds-card": "4.1.0",
    "@nice-digital/nds-checkbox": "4.1.0",
    "@nice-digital/nds-column-list": "4.1.0",
    "@nice-digital/nds-container": "4.1.0",
    "@nice-digital/nds-core": "4.1.0",
    "@nice-digital/nds-enhanced-pagination": "4.1.0",
    "@nice-digital/nds-filters": "5.1.0",
    "@nice-digital/nds-form-group": "4.1.0",
    "@nice-digital/nds-full-bleed": "4.1.0",
    "@nice-digital/nds-grid": "4.1.0",
    "@nice-digital/nds-horizontal-nav": "4.1.0",
    "@nice-digital/nds-input": "4.1.0",
    "@nice-digital/nds-page-header": "4.1.0",
    "@nice-digital/nds-panel": "4.1.0",
    "@nice-digital/nds-phase-banner": "4.1.0",
    "@nice-digital/nds-prev-next": "4.1.0",
    "@nice-digital/nds-radio": "4.1.1",
    "@nice-digital/nds-simple-pagination": "4.1.0",
    "@nice-digital/nds-stacked-nav": "4.1.0",
    "@nice-digital/nds-table": "4.1.0",
    "@nice-digital/nds-tabs": "4.1.0",
    "@nice-digital/nds-tag": "4.1.0",
    "@nice-digital/nds-textarea": "4.1.0",
    "@payloadcms/db-postgres": "3.88.0",
    "@payloadcms/next": "3.88.0",
    "@payloadcms/richtext-lexical": "3.88.0",
    "@payloadcms/ui": "3.88.0",
    "@tanstack/react-form": "^1.33.5",
    "clsx": "^2.1.1",
    "cross-env": "^7.0.3",
    "dotenv": "16.6.1",
    "graphql": "^16.14.0",
    "libphonenumber-js": "1.13.12",
    "jose": "^6.2.10",
    "next": "16.3.3",
    "payload": "3.88.0",
    "qrcode.react": "^4.2.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "0.0.1",
    "sharp": "0.35.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/config-helpers": "^0.7.0",
    "@faker-js/faker": "^10.6.0",
    "@hey-api/openapi-ts": "0.99.0",
    "@playwright/test": "1.62.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "22.20.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react": "4.7.0",
    "eslint": "^9.39.4",
    "eslint-config-next": "16.3.3",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import": "^2.32.0",
    "fallow": "2.104.0",
    "jsdom": "28.1.0",
    "prettier": "^3.9.6",
    "sass": "1.79.6",
    "stylelint": "^17.14.1",
    "stylelint-config-sass-guidelines": "^13.0.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "stylelint-order": "^8.1.1",
    "stylelint-scss": "^7.2.0",
    "stylelint-selector-bem-pattern": "^5.0.0",
    "tsx": "4.23.12",
    "typescript": "5.9.3",
    "vite-tsconfig-paths": "6.1.1",
    "vitest": "4.1.11"
  },
  "engines": {
    "node": ">=24.0.0",
    "pnpm": "^11"
  }
}
