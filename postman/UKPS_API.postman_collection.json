        {
          "name": "Deactivate Membership",
          "request": {
            "method": "PATCH",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/organisations/{{organisationId}}/memberships/{{membershipId}}/deactivate",
              "host": ["{{baseUrl}}"],
              "path": [
                "organisations",
                "{{organisationId}}",
                "memberships",
                "{{membershipId}}",
                "deactivate"
              ],
              "variable": [
                {
                  "key": "organisationId",
                  "value": "1",
                  "description": "The integer ID of the organisation that owns the membership"
                },
                {
                  "key": "membershipId",
                  "value": "1",
                  "description": "The integer ID of the membership to deactivate"
                }
              ]
            },
            "description": "Deactivates a user's membership within an organisation. Returns 404 if no membership exists with the given organisation ID and membership ID."
          },
          "response": [
            {
              "name": "200 OK - Membership deactivated",
              "status": "OK",
              "code": 200,
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json"
                }
              ],
              "body": "{\n  \"id\": 1,\n  \"userId\": 1,\n  \"organisationId\": 1,\n  \"userRole\": \"Standard\",\n  \"status\": \"Deactivated\",\n  \"allowedPharmaceuticalEntity\": 3,\n  \"createdAt\": \"2025-01-15T10:30:00Z\"\n}",
              "_postman_previewlanguage": "json"
            },
            {
              "name": "403 Forbidden - Not allowed",
              "status": "Forbidden",
              "code": 403,
              "header": [],
              "body": "The user is not authorised to perform this action.",
              "_postman_previewlanguage": "text"
            },
            {
              "name": "404 Not Found - Membership does not exist",
              "status": "Not Found",
              "code": 404,
              "header": [],
              "body": "Could not find a membership with organisation ID = 1 and membership ID = 9999.",
              "_postman_previewlanguage": "text"
            }
          ]
        },
        {
          "name": "Update Membership Role",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userRole\": \"Champion\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/organisations/{{organisationId}}/memberships/{{membershipId}}/update-role",
              "host": ["{{baseUrl}}"],
              "path": [
                "organisations",
                "{{organisationId}}",
                "memberships",
                "{{membershipId}}",
                "update-role"
              ],
              "variable": [
                {
                  "key": "organisationId",
                  "value": "1",
                  "description": "The integer ID of the organisation that owns the membership"
                },
                {
                  "key": "membershipId",
                  "value": "1",
                  "description": "The integer ID of the membership to update"
                }
              ]
            },
            "description": "Updates the role assigned to a user's membership within an organisation. Returns 404 if no membership exists with the given organisation ID and membership ID."
          },
          "response": [
            {
              "name": "200 OK - Role updated",
              "status": "OK",
              "code": 200,
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json"
                }
              ],
              "body": "{\n  \"id\": 1,\n  \"userId\": 1,\n  \"organisationId\": 1,\n  \"userRole\": \"Champion\",\n  \"status\": \"Active\",\n  \"allowedPharmaceuticalEntity\": 3,\n  \"createdAt\": \"2025-01-15T10:30:00Z\"\n}",
              "_postman_previewlanguage": "json"
            },
            {
              "name": "403 Forbidden - Not allowed",
              "status": "Forbidden",
              "code": 403,
              "header": [],
              "body": "The user is not authorised to perform this action.",
              "_postman_previewlanguage": "text"
            },
            {
              "name": "404 Not Found - Membership does not exist",
              "status": "Not Found",
              "code": 404,
              "header": [],
              "body": "Could not find a membership with organisation ID = 1 and membership ID = 9999.",
              "_postman_previewlanguage": "text"
            }
          ]
        }
      ]
    },
    {
      "name": "Users",
      "item": [
        {
          "name": "Get Users",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/users?page=1&pageSize=20&status=Active&status=Inactive&role=Champion&role=Super",
              "host": ["{{baseUrl}}"],
              "path": ["users"],
              "query": [
                {
                  "key": "organisationId",
                  "value": "{{organisationId}}",
                  "description": "Optional integer ID used to filter users by organisation",
                  "disabled": true
                },
                {
                  "key": "page",
                  "value": "1",
                  "description": "The 1-based page number"
                },
                {
                  "key": "pageSize",
                  "value": "20",
                  "description": "The number of users per page, from 1 to 100"
                },
                {
                  "key": "status",
                  "value": "Active",
                  "description": "Optional repeated UserOrgStatus filter"
                },
                {
                  "key": "status",
                  "value": "Inactive",
                  "description": "Optional repeated UserOrgStatus filter"
                },
                {
                  "key": "role",
                  "value": "Champion",
                  "description": "Optional repeated UserRole filter"
                },
                {
                  "key": "role",
                  "value": "Super",
                  "description": "Optional repeated UserRole filter"
                },
                {
                  "key": "email",
                  "value": "example.com",
                  "description": "Optional partial, case-insensitive match against the user's email address",
                  "disabled": true
                },
                {
                  "key": "lastActiveFrom",
                  "value": "2026-06-01T00:00:00Z",
                  "description": "Optional inclusive lower bound on the user's last active timestamp (ISO 8601)",
                  "disabled": true
                },
                {
                  "key": "lastActiveTo",
                  "value": "2026-07-01T00:00:00Z",
                  "description": "Optional inclusive upper bound on the user's last active timestamp (ISO 8601)",
                  "disabled": true
                }
              ]
            },
            "description": "Returns a paginated list of users. Optionally filter by organisationId. Returns 404 only when organisationId is supplied and no organisation with that ID exists. Status and Role can each be supplied as repeated query parameters. Email performs a partial, case-insensitive match. lastActiveFrom/lastActiveTo filter on an inclusive last-active timestamp range."
          },
          "response": [
            {
              "name": "200 OK - Users found",
              "status": "OK",
              "code": 200,
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json"
                }
              ],
              "body": "{\n  \"items\": [\n    {\n      \"userId\": 1,\n      \"emailAddress\": \"user@example.com\",\n      \"role\": \"Standard\",\n      \"status\": \"Active\",\n      \"lastActive\": \"2026-06-15T14:32:00Z\"\n    },\n    {\n      \"userId\": 2,\n      \"emailAddress\": \"another.user@example.com\",\n      \"role\": \"Champion\",\n      \"status\": \"Inactive\",\n      \"lastActive\": null\n    }\n  ],\n  \"totalCount\": 2,\n  \"page\": 1,\n  \"pageSize\": 20\n}",
              "_postman_previewlanguage": "json"
            },
            {
              "name": "200 OK - No users found",
              "status": "OK",
              "code": 200,
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json"
                }
              ],
              "body": "{\n  \"items\": [],\n  \"totalCount\": 0,\n  \"page\": 1,\n  \"pageSize\": 20\n}",
              "_postman_previewlanguage": "json"
            },
            {
              "name": "400 Bad Request - Invalid page",
              "status": "Bad Request",
              "code": 400,
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/problem+json"
                }
              ],
              "body": "{\n  \"type\": \"https://tools.ietf.org/html/rfc9110#section-15.5.1\",\n  \"title\": \"One or more validation errors occurred.\",\n  \"status\": 400,\n  \"errors\": {\n    \"Page\": [\n      \"Page cannot be less than 1.\"\n    ]\n  }\n}",
              "_postman_previewlanguage": "json"
            },
            {
              "name": "404 Not Found - Supplied organisation does not exist",
              "status": "Not Found",
              "code": 404,
              "header": [],
              "body": "",
              "_postman_previewlanguage": "text"
            }
          ]
        }
      ]
    }
  ]
