                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"organisationName\": \"Example Pharma Ltd\",\n  \"headOfficeAddress\": \"10 Downing Street\\nLondon\\nSW1A 2AA\",\n  \"headOfficeEmail\": \"contact@examplepharma.co.uk\",\n  \"headOfficeTelephone\": \"+44 20 7946 0000\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/organisations/{{organisationId}}",
              "host": ["{{baseUrl}}"],
              "path": ["organisations", "{{organisationId}}"],
              "variable": [
                {
                  "key": "organisationId",
                  "value": "1",
                  "description": "The integer ID of the organisation to update"
                }
              ]
            },
            "description": "Fully replaces the editable organisation details for the given ID. Head office address is a required multiline text value."
          },
          "response": [
            {
              "name": "200 OK - Organisation updated",
              "status": "OK",
              "code": 200,
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json"
                }
              ],
              "body": "{\n  \"id\": 1,\n  \"organisationName\": \"Example Pharma Ltd\",\n  \"organisationType\": 0,\n  \"allowedPharmaceuticalEntity\": 3,\n  \"countryOrRegion\": \"United Kingdom\",\n  \"headOfficeAddress\": \"10 Downing Street\\nLondon\\nSW1A 2AA\",\n  \"headOfficeEmail\": \"contact@examplepharma.co.uk\",\n  \"headOfficeTelephone\": \"+44 20 7946 0000\",\n  \"status\": 1,\n  \"lastActive\": \"2026-06-01T09:00:00Z\",\n  \"createdAt\": \"2025-01-15T10:30:00Z\"\n}",
