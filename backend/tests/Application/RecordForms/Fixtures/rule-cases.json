    { "name": "required text whitespace only", "multiple": false, "rules": [{ "kind": "Required", "value": null, "message": "Enter a value" }], "answer": "   ", "error": "Enter a value" },
    { "name": "optional text null", "multiple": false, "rules": [], "answer": null, "error": null },
    { "name": "max length at limit", "multiple": false, "rules": [{ "kind": "MaxLength", "value": 5, "message": "Too long" }], "answer": "abcde", "error": null },
