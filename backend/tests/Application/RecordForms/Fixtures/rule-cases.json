    { "name": "max items at limit", "multiple": true, "rules": [{ "kind": "MaxItems", "value": 3, "message": "Select up to 3" }], "answer": ["1", "2", "3"], "error": null },
    { "name": "max items over limit", "multiple": true, "rules": [{ "kind": "MaxItems", "value": 3, "message": "Select up to 3" }], "answer": ["1", "2", "3", "4"], "error": "Select up to 3" },
    { "name": "optional multi none ticked", "multiple": true, "rules": [{ "kind": "MaxItems", "value": 3, "message": "Select up to 3" }], "answer": [], "error": null }
