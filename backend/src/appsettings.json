{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": "<from-environment-variable>"
  },
  "Seeding": {
    "ReseedOnStartup": false,
    "SuperUsersJson": "[]"
  },
  "AWS": {
    "LoadSecrets": true,
    "Region": "eu-west-2"
  },
  "Cognito": {
    "ServiceUrlOverride": null,
    "Region": "<from-environment-variable>",
    "UserPoolId": "<from-environment-variable>",
    "ClientId": "<from-environment-variable>",
    "ClientSecret": "<from-aws-secrets>"
  },
  "Database": {
    "MigrateOnStartup": false,
    "Host": null,
    "Name": null,
    "Password": null,
    "Port": null,
    "Username": null
  },
  "DevAuthentication": {
    "IsEnabled": false
  },
  "Email": {
    "FromAddress": "no-reply@dev.ukps.nice.org.uk"
  },
  "UserOnboarding": {
    "SetupLink": "https://placeholder",
    "SetupTokenExpiryTimeSeconds": 900
  }
}
