{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": null
  },
  "Seeding": {
    "ReseedOnStartup": false,
    "SeedUsersJson": "[]"
  },
  "AWS": {
    "LoadSecrets": false,
    "Region": "eu-west-2"
  },
  "Cognito": {
    "ServiceUrlOverride": null,
    "Region": "<from-environment-variable>",
    "UserPoolId": "<from-environment-variable>",
    "ClientId": "<from-environment-variable>",
    "ClientSecret": "<from-aws-secrets>"
  },
  "Database": {
    "MigrateOnStartup": false,
    "Host": "<from-environment-variable>",
    "Name": "<from-environment-variable>",
    "Password": "<from-aws-secrets>",
    "Port": null,
    "RootCertificate": null,
    "Username": "<from-aws-secrets>"
  },
  "DevAuthentication": {
    "IsEnabled": false,
    "UserRole": "Super"
  },
  "Email": {
    "MaxResendSignUpLinkAttempts": 3,
    "TestingEmailAddress": null,
    "FromAddress": "<from-environment-variable>",
    "QueueUrl": "<from-environment-variable>",
    "QueueMaxNumberOfMessages": 1,
    "QueueWaitTimeInSeconds": 20
  },
  "UserOnboarding": {
    "SetupLink": "https://placeholder",
    "SetupTokenExpiryTimeSeconds": 900
  }
}
