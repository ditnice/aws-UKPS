<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <RootNamespace>UKPS.ErdGenerator</RootNamespace>
    <!-- Build-time documentation tool: not published with, or referenced by, the API.
         CA1303/S6966: console output does not need localisation or async writes. -->
    <NoWarn>$(NoWarn);CA1303;S6966</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="YamlDotNet" Version="18.1.0" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource
      Include="ErdViewerTemplate.html"
      LogicalName="UKPS.ErdGenerator.ErdViewerTemplate.html"
    />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/UKPS.Api.csproj" />
  </ItemGroup>
</Project>
