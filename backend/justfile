default: format build test

format:
    dotnet csharpier format .

format-check:
    dotnet csharpier check .

build:
    dotnet build

run:
    dotnet ef database update --project src --startup-project src
    dotnet run --project src --launch-profile https

generate-migration name:
    dotnet ef migrations add {{name}} --project src --startup-project src --output-dir Persistence/Migrations

test:
    dotnet test

coverage:
    dotnet test /p:CollectCoverage=true
    dotnet tool run reportgenerator

erd:
    dotnet run --project tools/UKPS.ErdGenerator -- --groups ../documentation/database/erd-groups.yml --output ../documentation/database/ukps-erd.mmd --html ../documentation/database/ukps-erd.html
